{
  "name": "rfnoter",
  "version": "2.2.1",
  "description": "Real Fast Noter - A lightweight, fast note-taking app with AI summary support",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "app:selftest": "electron . --selftest",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test"
  },
  "keywords": [
    "notes",
    "notetaking",
    "ai-summary",
    "deepseek",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  }
}
